# PostHog (funnel analytics). Copy to .env.local for dev, and set these in the
# Vercel project's Environment Variables for production. Without the key, PostHog
# stays off and the app runs normally (Vercel Web Analytics still works).
#
# Project API key from PostHog → Settings → Project → "Project API Key" (phc_...).
# It's a publishable client key — safe to expose in the browser bundle.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key_here

# Region host: US = https://us.i.posthog.com  ·  EU = https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
